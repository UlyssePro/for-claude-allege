# Base de données SQLite locale (utilisée par Prisma via prisma.config.ts)
DATABASE_URL="file:./dev.db"

# Secret pour signer les cookies/sessions d'authentification (à générer,
# ex: openssl rand -base64 32). Remplace le système actuel "logged: true"
# stocké dans users, qui n'offre aucune vraie sécurité.
AUTH_SECRET="change-me"
